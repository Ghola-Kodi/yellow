# ============================================================
# SUPABASE
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Publishable/anon key (safe for the browser).
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
# Secret/service-role key (server only — never expose to the client).
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# ============================================================
# STRIPE (Test Mode)
# ============================================================
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Optional — a recurring price used by the "real Stripe decline" simulator.
STRIPE_PRICE_ID=price_...

# ============================================================
# KLAVIYO
# ============================================================
# Get from Klaviyo → Settings → API keys (private key).
KLAVIYO_PRIVATE_API_KEY=pk_...

# Optional — override the event/metric names the worker sends. Defaults:
#   dunning-soft-retry, dunning-hard-update-required,
#   dunning-auth-required, dunning-final-notice,
#   payment_recovered, subscription_canceled
# KLAVIYO_EVENT_SOFT_RETRY=dunning-soft-retry
# KLAVIYO_EVENT_HARD_UPDATE_REQUIRED=dunning-hard-update-required
# KLAVIYO_EVENT_AUTH_REQUIRED=dunning-auth-required
# KLAVIYO_EVENT_FINAL_NOTICE=dunning-final-notice
# KLAVIYO_EVENT_RECOVERED=payment_recovered
# KLAVIYO_EVENT_CANCELED=subscription_canceled

# ============================================================
# DUNNING TUNING
# ============================================================
DUNNING_START_AFTER_ATTEMPT=2
DUNNING_MAX_ATTEMPTS=4
DUNNING_GIVE_UP_HOURS=72

# ============================================================
# APP
# ============================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Protects the cron endpoint (Bearer token or ?secret= query param).
CRON_SECRET=change-me
