# ============================================
# SUPABASE
# ============================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================
# STRIPE (Test Mode)
# ============================================
# Use sk_test_... for development/demo
# Use sk_live_... for production
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ============================================
# KLAVIYO (Test Account)
# ============================================
# Get from: https://www.klaviyo.com/settings/api-keys
KLAVIYO_PRIVATE_API_KEY=pk_test_your_klaviyo_key
KLAVIYO_PUBLIC_API_KEY=your-public-key

# Klaviyo Flow IDs (configured in your test Klaviyo account)
KLAVIYO_FLOW_SOFT_REMINDER=your-flow-id-1
KLAVIYO_FLOW_HARD_URGENT=your-flow-id-2
KLAVIYO_FLOW_WINBACK=your-flow-id-3

# ============================================
# APP CONFIG
# ============================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=true
